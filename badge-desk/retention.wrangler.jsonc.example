{
  "name": "visitor-badge-photo-retention",
  "main": "src/retention-worker.js",
  "compatibility_date": "2026-06-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visitor-badge-desk",
      "database_id": "REPLACE_WITH_BADGE_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "visitor-badge-desk-id-photos" }
  ]
}
